<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Paperformat para etiqueta joyeria (65mm x 10mm) landscape -->
        <record id="paperformat_label_jewelry" model="report.paperformat">
            <field name="name">Etiqueta Joyeria 65x10mm</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_height">65</field>
            <field name="page_width">10</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="disable_shrinking" eval="True"/>
            <field name="dpi">96</field>
        </record>

        <!-- Reporte de etiqueta joyeria -->
        <record id="report_product_label_jewelry" model="ir.actions.report">
            <field name="name">Product Label Jewelry (PDF)</field>
            <field name="model">product.template</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">blink_product_label_jewelry.label_jewelry</field>
            <field name="report_file">blink_product_label_jewelry.label_jewelry</field>
            <field name="paperformat_id" ref="paperformat_label_jewelry"/>
            <field name="print_report_name">"Etiqueta Joyeria - %s" % (object.name)</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
