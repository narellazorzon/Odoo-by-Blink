<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Formato de papel térmico 80mm con altura dinámica -->
        <!-- La altura real se calcula en ir_actions_report.py según las líneas -->
        <!-- Este valor (200mm) es un fallback por si el cálculo dinámico falla -->
        <record id="paperformat_ticket_80mm" model="report.paperformat">
            <field name="name">Ticket Térmico 80mm</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_height">200</field>
            <field name="page_width">80</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">2</field>
            <field name="margin_right">2</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
        </record>
    </data>
</odoo>
