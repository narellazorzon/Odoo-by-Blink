<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="blink_pos_thermal_invoice.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <!-- Ocultar botón Invoice estándar cuando factura electrónica térmica está habilitada -->
        <xpath expr="//button[hasclass('js_invoice')]" position="attributes">
            <attribute name="t-if">!this.isElectronicInvoiceEnabled</attribute>
        </xpath>

        <!-- Agregar toggle de Factura Electrónica después del botón de cliente -->
        <xpath expr="//div[hasclass('payment-buttons')]/div[1]" position="after">
            <div t-if="isElectronicInvoiceEnabled" class="d-flex flex-column flex-sm-row gap-2 w-100">
                <button class="button btn btn-lg d-flex justify-content-between align-items-baseline w-100 lh-lg"
                    t-att-class="isElectronicInvoice ? 'btn-success' : 'btn-outline-secondary'"
                    t-on-click="toggleElectronicInvoice">
                    <span>
                        <i class="fa fa-file-text-o me-2"/>
                        <t t-if="isElectronicInvoice">Factura Electrónica</t>
                        <t t-else="">Sin Factura</t>
                    </span>
                    <i class="fa me-2"
                        t-att-class="isElectronicInvoice ? 'fa-toggle-on fa-lg' : 'fa-toggle-off fa-lg'"/>
                </button>
            </div>
        </xpath>
    </t>

</templates>
